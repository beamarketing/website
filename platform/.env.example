# ==========================================================================
# Beamr contact-based marketing engine — configuration
# Copy to .env and fill in. Real environment variables always win over .env.
# ==========================================================================

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Public origin of THIS server. Email open beacons, click redirects and
# unsubscribe links are all built from it, so it must be reachable from a
# recipient's inbox and browser. Use https in production.
PUBLIC_URL=https://abm.beamr.com

# Console + API auth. Generated and printed on first boot if left blank —
# set it explicitly so the token survives a container rebuild.
ADMIN_TOKEN=

# Signs tracking tokens and hashes IPs. Generated on first boot if blank.
# Changing it invalidates every unsubscribe and click link already in inboxes.
SECRET_KEY=

DB_PATH=./data/beamr-abm.db

# --------------------------------------------------------------- tracking --
# Domains allowed to POST to the collector. Subdomains are included
# automatically ("beamr.com" also allows www. and cloud.). Comma-separated.
# "*" allows any origin — fine for local development, never in production.
TRACKING_ORIGINS=beamr.com
COOKIE_DAYS=365

# ------------------------------------------------------------------ email --
# console = dry run: renders each message and writes it to data/outbox
# smtp | resend | sendgrid = real delivery
EMAIL_PROVIDER=console
EMAIL_FROM=marketing@beamr.com
EMAIL_FROM_NAME=Beamr
EMAIL_REPLY_TO=
# A physical postal address is legally required in marketing email (CAN-SPAM).
EMAIL_POSTAL_ADDRESS=Beamr Imaging Ltd., Herzliya, Israel
EMAIL_MAX_PER_MINUTE=60

# --- SMTP (works with Google Workspace, Amazon SES, Postmark, Mailgun, Postfix)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true only for implicit TLS on port 465
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=true      # refuse to send over a plaintext connection

# --- Alternatives (set EMAIL_PROVIDER to match)
RESEND_API_KEY=
SENDGRID_API_KEY=

# --------------------------------------------------------------- linkedin --
# Marketing Developer Platform token with:
#   r_ads, rw_ads, r_ads_reporting, rw_dmp_segments, r_marketing_leadgen_automation
# Without these the platform runs in dry-run: audiences build and diff locally
# but nothing is pushed and no metrics are pulled.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_API_VERSION=202506
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn will not serve ads to an audience below roughly this many
# *matched* members, so a smaller audience spends nothing.
LINKEDIN_MIN_AUDIENCE=300

# ------------------------------------------------------------------- jobs --
JOBS_ENABLED=true
JOB_QUEUE_INTERVAL=15        # drain the email send queue (seconds)
JOB_JOURNEY_INTERVAL=60      # evaluate journey triggers
JOB_SCORE_INTERVAL=3600      # recompute scores so time decay applies
JOB_AUDIENCE_INTERVAL=21600  # push matched audiences to LinkedIn
JOB_ADS_INTERVAL=21600       # pull ad metrics and lead-form responses

LOG_LEVEL=info
