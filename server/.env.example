# ============================================================================
# Beamr Dashboard backend — environment configuration
# Copy this file to ".env" and fill in real values, or set these as real
# environment variables on your host (Vercel, Railway, a VPS, etc.).
# If credentials for a channel are missing, that channel falls back to the
# built-in snapshot so the dashboard still renders.
# ============================================================================

# ---- Access control ----
# Shared password that gates the ENTIRE dashboard (page + API). On Vercel this
# is enforced at the edge by middleware.js; on the Express server it is enforced
# here. Set it to a strong secret and share it only with people who should see
# the data. On Vercel this is REQUIRED — if it is unset the site denies every
# request (fail closed). On the local Express server, leaving it unset keeps
# localhost open for development.
DASHBOARD_PASSWORD=
# Optional username for the login prompt (defaults to "beamr").
DASHBOARD_USER=beamr

# ---- Server ----
PORT=3000
# How long to cache each upstream response, in seconds. The dashboard fetches
# live on every load; this cache keeps us well under any API rate limit.
# 21600 = 6 hours (refreshes multiple times per day).
CACHE_TTL_SECONDS=21600

# ---- Facebook / Meta Marketing API ----
# Ad account id WITHOUT the "act_" prefix. Beamr Marketing = 1736901387696242
META_AD_ACCOUNT_ID=1736901387696242
# A long-lived (system user) access token with ads_read permission.
# Create one at https://business.facebook.com → Business settings → System users.
META_ACCESS_TOKEN=
# Graph API version.
META_API_VERSION=v20.0

# ---- LinkedIn Marketing API ----
# Sponsored ad account id (the numeric id only, no urn prefix).
LINKEDIN_AD_ACCOUNT_ID=
# OAuth 2.0 access token with r_ads + r_ads_reporting scopes.
# Requires the "Advertising API" product to be approved on your LinkedIn app:
# https://learn.microsoft.com/en-us/linkedin/marketing/
LINKEDIN_ACCESS_TOKEN=
# LinkedIn API version header (YYYYMM). Must be a currently-active LinkedIn API
# version. If /api/metrics reports "NONEXISTENT_VERSION", bump/adjust to an
# active YYYYMM (verified active: 202503).
LINKEDIN_VERSION=202503

# ---- Reporting window (OPTIONAL) ----
# By default the server auto-computes the CURRENT quarter and year-to-date from
# today's date, so live queries always target the real current period. Only set
# these to pin a specific window (format: YYYY-MM-DD); otherwise leave unset.
# QUARTER_START=2026-07-01
# QUARTER_END=2026-09-30
# YEAR_START=2026-01-01
